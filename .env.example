# Copy this file to .env and fill in real values before running the server.

# Port the API listens on (Render/Railway inject this automatically in production)
PORT=4000

# Secret used to sign JWT access tokens - use a long random string in production
JWT_SECRET=replace_this_with_a_long_random_string

# JWT access token lifetime
JWT_EXPIRES_IN=7d

# Google Sign-In: OAuth 2.0 Web Client ID from Google Cloud Console
# (Android app's Web client ID, used to verify Google ID tokens server-side)
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Path to Firebase service account JSON (for sending push notifications via FCM)
# Download from Firebase Console > Project Settings > Service Accounts
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Google AI Studio (Gemini) API key — powers the real AI Study Assist feature
# (summaries, Q&A, recommendations). Get a free one at https://aistudio.google.com/apikey
# If left blank, AI Study Assist automatically falls back to built-in local logic.
GEMINI_API_KEY=
